# Aktywny tryb: openrouter | openai_compatible | none
# Zmienne środowiska mają pierwszeństwo przed tym plikiem.
DOXFORGE_LLM=openrouter

# Lokalny OCR na CPU: 3 lekkie modele albo pojedynczy PP-OCRv6.
DOXFORGE_OCR=ensemble3
DOXFORGE_OCR_THREADS=1

# OpenRouter — wklej klucz z panelu OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/
OPENROUTER_MODEL=mistralai/ministral-8b-2512
# Lista endpointów rozdzielona przecinkami; brak fallbacku poza tą listą.
OPENROUTER_PROVIDERS=mistral/eu
OPENROUTER_MAX_TOKENS=4096
OPENROUTER_MIN_INTERVAL_S=1.2
# Regionalna brama wymaga uprawnień Business/Enterprise:
# OPENROUTER_BASE_URL=https://eu.openrouter.ai/api/v1/
# mistral/eu ogranicza upstream, ale zwykła brama nie gwarantuje UE/EOG.
# Zweryfikuj lokalizację całego przetwarzania i warunki EU-only przed oceną.

# Bezpośredni Mistral — aktywuj przez DOXFORGE_LLM=openai_compatible.
LLM_BASE_URL=https://api.eu.mistral.ai/v1/
LLM_MODEL=ministral-8b-2512
LLM_API_KEY=
