# Aktywny tryb: openai_compatible (bezpośrednio Mistral EU) | openrouter | none (same reguły)
# Zmienne środowiska mają pierwszeństwo przed tym plikiem.
DOXFORGE_LLM=openai_compatible

# Bezpośredni Mistral, region UE (La Plateforme). Ministral 3 8B (Apache-2.0); przypięta wersja.
LLM_BASE_URL=https://api.eu.mistral.ai/v1/
LLM_MODEL=ministral-8b-2512
LLM_API_KEY=

# Lokalny OCR na CPU: 3 lekkie modele albo pojedynczy PP-OCRv6.
DOXFORGE_OCR=ensemble3
DOXFORGE_OCR_THREADS=1

# Alternatywa (wyłączona): OpenRouter z wymuszonym dostawcą mistral/eu — aktywuj DOXFORGE_LLM=openrouter.
# Zwykła brama OpenRouter nie gwarantuje całej ścieżki UE/EOG.
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/
# OPENROUTER_MODEL=mistralai/ministral-8b-2512
# OPENROUTER_PROVIDERS=mistral/eu
# OPENROUTER_MAX_TOKENS=4096
# OPENROUTER_MIN_INTERVAL_S=1.2
